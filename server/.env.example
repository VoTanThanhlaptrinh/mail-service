# Database. Either a local SQLite file (creates the data/ directory automatically):
DATABASE_URL="./data/mail.db"
# ...or a Turso / libSQL database (required on Vercel), together with its auth token:
# DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
# TURSO_AUTH_TOKEN=""

# HTTP port for the API
PORT=4000

# Allowed browser origin for CORS (comma separated)
CORS_ORIGIN="http://localhost:5173"

# SMTP transport configuration for outgoing emails (Mailpit default is port 1025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mail Service <no-reply@example.com>"
