# PostgreSQL connection string used by the API (docker compose maps host port 5433).
DATABASE_URL="postgresql://mail:mail@localhost:5433/mail_service"

# HTTP port for the API
PORT=4000

# Allowed browser origin for CORS (comma separated)
CORS_ORIGIN="http://localhost:5173"

# SMTP transport configuration for outgoing emails
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mail Service <no-reply@example.com>"
