# Local SQLite file, used for dev / Docker (creates the data/ directory automatically).
# Ignored whenever TURSO_DATABASE_URL below is set.
DATABASE_URL="./data/mail.db"

# Turso (libSQL) database. REQUIRED on Vercel; leave both empty to use the local file above.
# URL looks like: libsql://<your-db>-<your-org>.turso.io
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# HTTP port for the API
PORT=4000

# Allowed browser origin for CORS (comma separated)
CORS_ORIGIN="http://localhost:5173"

# SMTP transport configuration for outgoing emails (Mailpit default is port 1025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mail Service <no-reply@example.com>"

# Kafka event bus. Comma separated host:port list; defaults to a local PLAINTEXT broker.
# Inside Docker, a broker on the host is reachable as host.docker.internal:9092.
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="mail-service"

# Cloud (Aiven for Apache Kafka) requires TLS; enable SASL in the Aiven console, then
# copy the bootstrap server, service user and password:
#   KAFKA_BROKERS="<service>-<project>.aivencloud.com:<sasl_port>"
#   KAFKA_SSL=true
#   KAFKA_SASL_MECHANISM="scram-sha-512"   # Aiven also supports "plain" / "scram-sha-256"
#   KAFKA_SASL_USERNAME="<service_user>"
#   KAFKA_SASL_PASSWORD="<password>"
#   KAFKA_SSL_CA="./certs/ca.pem"          # optional: Aiven project CA (ca.pem)
# Leave both SASL values empty for a local PLAINTEXT broker.
KAFKA_SSL=false
KAFKA_SSL_CA=""
KAFKA_SASL_MECHANISM="scram-sha-512"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# Built-in mail consumer: every message on KAFKA_MAIL_TOPIC is JSON {"to","subject","body"}
# and is sent via SMTP. Failed messages (invalid JSON/payload or SMTP errors) go to KAFKA_DLQ_TOPIC.
KAFKA_CONSUMER_ENABLED=true
KAFKA_CONSUMER_GROUP="mail-service"
KAFKA_MAIL_TOPIC="mail.send"
KAFKA_DLQ_TOPIC="mail.send.dlq"
